# Normalize line endings: LF in the repository, per-file overrides below
* text=auto eol=lf

*.ino   text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.svg   text eol=lf
*.scad  text eol=lf
*.sh    text eol=lf
*.txt   text eol=lf

*.bat   text eol=crlf
*.ps1   text eol=crlf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.mp4   binary
*.mov   binary
*.pdf   binary
*.stl   binary
*.zip   binary